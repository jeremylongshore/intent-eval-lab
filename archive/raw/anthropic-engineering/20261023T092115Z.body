.io/images/4zrzovbb/website/ac3c5e02411e83e96a36ca08523c3904115b81d4-2000x1125.jpg\",\"width\":2000},\"linkedUrl\":null,\"newsCategories\":null,\"publishedOn\":\"2025-06-18\",\"sensitive\":null,\"seoDescription\":\"Announcing a new collaborative research paper on Confidential Inference, a set of tools to improve the security of our model weights and of our users' data.\",\"slug\":{\"_type\":\"slug\",\"current\":\"confidential-inference-trusted-vms\"},\"summary\":null,\"title\":\"Confidential Inference via Trusted Virtual Machines\",\"topicTag\":{\"name\":\"Privacy\",\"topic\":\"policy\"},\"topics\":[\"policy\",\"understanding-ai\",\"safety\",\"anthropic\"]},{\"_id\":\"article-4d839e4f-bbc6-46f3-acff-dbfb9feb47aa\",\"_type\":\"article\",\"_updatedAt\":\"2026-10-09T06:14:11Z\",\"articleType\":\"research\",\"bodyImages\":[{\"description\":null,\"height\":2579,\"hotspot\":null,\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/1198befc0b33726c45692ac40f764022f4de1bf2-4584x2579.png\",\"width\":4584},{\"description\":null,\"height\":4584,\"hotspot\":null,\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/3bde53c9578d74f6e05c3e515e20b910c5a8c20a-4584x4584.png\",\"width\":4584},{\"description\":null,\"height\":2148,\"hotspot\":null,\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/09a90e0aca54859553e93c18683e7fd33ff16d4c-2654x2148.png\",\"width\":2654}],\"cardImage\":null,\"cardTeams\":[{\"slug\":\"engineering\",\"title\":\"Engineering\"}],\"hero\":null,\"linkedUrl\":null,\"newsCategories\":null,\"publishedOn\":\"2025-06-13\",\"sensitive\":null,\"seoDescription\":\"On the the engineering challenges and lessons learned from building Claude's Research system\",\"slug\":{\"_type\":\"slug\",\"current\":\"multi-agent-research-system\"},\"summary\":null,\"title\":\"How we built our multi-agent research system\",\"topicTag\":{\"name\":\"Agents\",\"topic\":\"understanding-ai\"},\"topics\":[\"understanding-ai\",\"claude\"]},{\"_id\":\"article-052ae47e-ea95-4699-bac4-