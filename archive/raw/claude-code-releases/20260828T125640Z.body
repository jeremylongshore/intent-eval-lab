  <entry>
    <id>tag:github.com,2008:Repository/937253475/v2.1.241</id>
    <updated>2026-08-23T00:52:16Z</updated>
    <link rel="alternate" type="text/html" href="https://github.com/anthropics/claude-code/releases/tag/v2.1.241"/>
    <title>v2.1.241</title>
    <content type="html">&lt;h2&gt;What&#39;s changed&lt;/h2&gt;
&lt;ul&gt;
&lt;li&gt;Bug fixes and reliability improvements&lt;/li&gt;
&lt;/ul&gt;</content>
    <author>
      <name>ashwin-ant</name>
    </author>
